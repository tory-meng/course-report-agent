  "calculation_semantics": {
    "role": "供计算工具和模型理解；不替换Word母版的公式显示",
    "equation_1": "A[s,i] = sum_m(x[s,i,m] * b[i,m]) / sum_m(M[i,m] * b[i,m])",
    "equation_2": "R[i] = count(s in valid[i] where A[s,i] >= threshold[i]) / len(valid[i])",
    "class_average": "mean(A[s,i] for s in valid[i])",
    "symbols": {
      "s": "学生",
      "i": "课程目标",
      "m": "支撑目标的考核项/方式",
      "x": "同一已确认尺度的实际得分",
      "M": "对应满分",
      "b": "本轮正式方案的对应系数"
    },
    "preconditions": [
      "分子分母使用同一尺度和已核验系数",
      "已经折合的得分不得重复乘入同一权重",
      "缺考、缓考、免修、缺失按本轮制度确定有效样本",
      "加权满分分母必须大于0；有效人数为0时不输出比例",
      "阈值来源已确认后才判断达标，边界使用大于等于",
      "百分数只作显示换算，保留未舍入计算值"
    ]
  },
